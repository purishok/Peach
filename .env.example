# Prefer an AWS CLI profile or `aws login`; do not commit long-lived access keys.
AWS_PROFILE=
AWS_REGION=
AUTH_AWS_REGION=
PROJECT_NAME=


# USER INPUT REQUIRED: Google OAuth Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# USER INPUT REQUIRED: globally unique lowercase Cognito prefix.
COGNITO_DOMAIN_PREFIX=

# Existing deployed frontend. Change only if the deployment changes.
FRONTEND_URL=
FRONTEND_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=
NEXT_PUBLIC_COGNITO_AUTHORITY=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=
NEXT_PUBLIC_COGNITO_LOGOUT_URI=
# Existing Lab 2 ECS service (defaults shown).
ECS_CLUSTER=
ECS_SERVICE=
ECS_CONTAINER_NAME=

# Written automatically by `make auth-deploy`; do not copy these manually.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_AUTHORITY=
COGNITO_REDIRECT_URI=
COGNITO_LOGOUT_URI=

# Written by the existing backend deployment workflow.
BACKEND_URL=
API_CORS_ORIGINS=

# Weekly reports (SES sender/recipients are never compiled into the frontend).
REPORTS_STACK_NAME=
REPORT_SENDER_EMAIL=
REPORT_RECIPIENT_EMAILS=
SES_IDENTITY_NAME=
CREATE_SES_EMAIL_IDENTITY=false
DB_INSTANCE_IDENTIFIER=peach-db
DATABASE_SECRET_ARN=
REPORTS_LAMBDA_ARCHITECTURE=arm64
